    "RakshaStepFunction": {
      "Type": "AWS::StepFunctions::StateMachine",
      "Properties": {
        "StateMachineName": "RakshaOutreachAutomation-dev",
        "RoleArn": {
          "Fn::GetAtt": [
            "StepFunctionsRole",
            "Arn"
          ]
        },
        "DefinitionString": {
          "Fn::Sub": "{\n  \"Comment\": \"Raksha Thalassemia Blood Request Automation Flow\",\n  \"StartAt\": \"MatchDonor\",\n  \"States\": {\n    \"MatchDonor\": {\n      \"Type\": \"Task\",\n      \"Resource\": \"arn:aws:lambda:${AWS::Region}:${AWS::AccountId}:function:raksha-ai-api-dev-match\",\n      \"Next\": \"ChoiceDonorFound\"\n    },\n    \"ChoiceDonorFound\": {\n      \"Type\": \"Choice\",\n      \"Choices\": [\n        {\n          \"Variable\": \"$.status\",\n          \"StringEquals\": \"NO_DONOR_FOUND\",\n          \"Next\": \"EndNoDonor\"\n        }\n      ],\n      \"Default\": \"SendOutreach\"\n    },\n    \"SendOutreach\": {\n      \"Type\": \"Task\",\n      \"Resource\": \"arn:aws:states:::sns:publish\",\n      \"Parameters\": {\n        \"PhoneNumber.$\": \"$.donor_phone\",\n        \"Message.$\": \"$.outreach_message\"\n      },\n      \"Next\": \"WaitPeriod\"\n    },\n    \"WaitPeriod\": {\n      \"Type\": \"Wait\",\n      \"SecondsPath\": \"$.wait_seconds\",\n      \"Next\": \"CheckResponse\"\n    },\n    \"CheckResponse\": {\n      \"Type\": \"Task\",\n      \"Resource\": \"arn:aws:lambda:${AWS::Region}:${AWS::AccountId}:function:raksha-ai-api-dev-checkResponse\",\n      \"Next\": \"ChoiceResponseReceived\"\n    },\n    \"ChoiceResponseReceived\": {\n      \"Type\": \"Choice\",\n      \"Choices\": [\n        {\n          \"Variable\": \"$.status\",\n          \"StringEquals\": \"FULFILLED\",\n          \"Next\": \"EndFulfilled\"\n        }\n      ],\n      \"Default\": \"EscalateOutreach\"\n    },\n    \"EscalateOutreach\": {\n      \"Type\": \"Task\",\n      \"Resource\": \"arn:aws:lambda:${AWS::Region}:${AWS::AccountId}:function:raksha-ai-api-dev-escalate\",\n      \"Next\": \"EndEscalated\"\n    },\n    \"EndNoDonor\": {\n      \"Type\": \"Pass\",\n      \"End\": true\n    },\n    \"EndFulfilled\": {\n      \"Type\": \"Pass\",\n      \"End\": true\n    },\n    \"EndEscalated\": {\n      \"Type\": \"Pass\",\n      \"End\": true\n    }\n  }\n}\n"
        }
      }
    },
    "RakshaDashboard": {
      "Type": "AWS::CloudWatch::Dashboard",
      "Properties": {
